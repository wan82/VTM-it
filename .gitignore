# ============================================================
# VTM-it .gitignore
# 原则：代码/配置/文档/小标签入库；构建产物、虚拟环境、大数据、生成日志不入库。
# 官方 VTM 源码入库，但其 build/ 产物不入库。
# 注意：.gitignore 不支持「行尾注释」——# 只有在行首才是注释，
#       所以所有说明都单独成行，模式行后面绝不能跟 # 注释。
# ============================================================

# ---- 构建产物（任意层级的 build/ 目录都忽略）----
# 不要用裸 bin/ 或 lib/：macOS 默认 core.ignorecase，lib/ 会误伤 VTM 的 source/Lib。
build/
*.o
*.a
*.so
*.dylib
*.out
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.cmake/
.cache/

# ---- Python 虚拟环境 / 缓存 ----
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ---- 大数据 / 输入码流（太大，不入库；本地保留）----
# VTM 编出的 RA 码流（数百 MB）
Data/binEncode202/
*.bin
# 裸 YUV / 重建 YUV（含残留 rec.yuv）
*.yuv

# ---- 生成的中间件 / 训练产物 / 日志（可由流程重生）----
# 采集/合并中间表
Data/temp/
# 机器产物：qtForest.bin + models/*.json
Data/ModelResults/
# QT 训练集（make merge 重生）
Data/TrainingData/Training.csv
# MTT 训练集（make mttFeature 重生）
Data/TrainingData/TrainingMtt.csv
# 采样导出的 MTT 标签（make mttLabel 重生）
Data/labelMtt/
# fastTest 等运行日志
Data/Log/

# 说明：以下「成本高但小」的产物默认保留入库，便于直接复现/对照；如不想入库可取消注释：
# Data/labelCtu/
# Data/LogOriginalEnc/
# Report/

# ---- 子项目里的临时测试输出 ----
# 采集器无配置时的回退输出目录
yuvFeatureExtract/output/
# 合成自测输出
yuvFeatureExtract/outTest/

# ---- 冗余归档 ----
# 官方源码压缩包（已解压，冗余）
VVCSoftware_VTM-VTM-20.2.zip
# 历史归档（早期内嵌原型 + 退役脚本）
oldFashion/
# 历史归档压缩包（已解压，冗余）
oldFashion.zip

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
*.swp
*~
# IDE 配置含机器特定绝对路径，不入库（如需共享可改用 ${workspaceFolder}）
.vscode/
